{
  "name": "cadence-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/core",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "seed": "npm run seed -w apps/web",
    "test": "npm run test -w packages/core && npm run test -w apps/web",
    "test:browser": "node apps/web/tests/browser/journeys.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.61.1"
  }
}
